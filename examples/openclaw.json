{
  "dataset": "${DATASET_MANIFEST}",
  "agent": "openclaw",
  "workers": 10,
  "strategy": "pipe",
  "pipe_mode": "multi",
  "subagents": true,
  "invalid_retries": 5,
  "thinking": "high",
  "tool_timeout": 300,
  "api_timeout": 300,
  "model_concurrency": 30,
  "image_concurrency": 10,
  "proc_mode": "minimal",
  "runtime": {
    "manifest": "${RUNTIME_MANIFEST}",
    "bwrap": "${BWRAP_PATH}",
    "mcp_modules": "${MCP_MODULES}",
    "openclaw": "${OPENCLAW_RUNTIME}",
    "openclaw_modules": "${OPENCLAW_MODULES}",
    "python": "${PYTHON_RUNTIME}"
  },
  "model": {
    "protocol": "gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta",
    "model": "${GEMINI_MODEL}",
    "api_key_env": "GEMINI_API_KEY"
  },
  "image": {
    "protocol": "gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta",
    "model": "gemini-3.1-flash-image",
    "api_key_env": "GEMINI_API_KEY"
  }
}
